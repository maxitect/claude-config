{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-skill-gate.zsh\"; [ -x \"$f\" ] || f=\"$HOME/.claude/hooks/commit-skill-gate.zsh\"; \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "figma@claude-plugins-official": true,
    "caveman@caveman": true,
    "claude-mem@thedotmack": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "vercel@anthropic-plugin-directory": true,
    "neon@anthropic-plugin-directory": true,
    "netlify@anthropic-plugin-directory": true,
    "docker-skills@anthropic-plugin-directory": true,
    "resend@anthropic-plugin-directory": true,
    "notion@anthropic-plugin-directory": true,
    "cloudflare@claude-plugins-official": true,
    "roadmap@goblin-mode": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/juliusbrussee/caveman.git"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "git",
        "url": "https://github.com/ayghri/i-have-adhd.git"
      }
    },
    "goblin-mode": {
      "source": {
        "source": "git",
        "url": "https://github.com/JasonWarrenUK/goblin-mode.git"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "idleCompaction": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(poetry run poe test:*)",
      "Bash(poetry run poe lint:*)",
      "Bash(poetry run poe fmt:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(psql:* DROP*)",
      "Bash(supabase db reset:*)"
    ]
  }
}
